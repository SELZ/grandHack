# Node.js >= 22. Run `npm run setup` once to create .env with random local secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
ALLOW_DEV_AUTH=true
# Must remain false while testing locally. No messages are sent by the API.
NOTIFICATIONS_ENABLED=false
MAX_BOT_USERNAME=t511_hakaton_max_bot
MAX_BOT_TOKEN=
JWT_SECRET=
INTERNAL_API_KEY=
API_BASE_URL=http://127.0.0.1:4000
# Paths below are relative to grants-backend, not the shell cwd.
DB_PATH=data/grants.db
FRONTEND_DIST=../grants/dist
NOTIFY_TIMEZONE=Europe/Moscow
NOTIFY_CRON=0 9 * * *
DEADLINE_WARNING_DAYS=3
